@model Doctor
@{ ViewData["Title"] = Model.DoctorName; }

<div class="back-link"><a asp-action="Index">&#8592; Back to doctors</a></div>
<section class="detail-panel"><div class="detail-intro"><div class="doctor-avatar large">@Model.DoctorName.Split(' ').LastOrDefault()?.FirstOrDefault()</div><div><span class="specialty-tag">@Model.Specialization</span><h1>@Model.DoctorName</h1><p class="muted">Experienced specialist with @Model.Experience years in practice.</p></div></div><div class="detail-grid"><div><span>Doctor ID</span><strong>#@Model.DoctorId</strong></div><div><span>Experience</span><strong>@Model.Experience years</strong></div><div><span>Consultation fee</span><strong>&#8377;@Model.ConsultationFee.ToString("N0")</strong></div><div><span>Service fee</span><strong>&#8377;@DoctorExtensions.ServiceFee.ToString("N0")</strong></div><div class="highlight"><span>Total charge</span><strong>&#8377;@Model.CalculateTotalCharge().ToString("N0")</strong></div></div><div class="detail-actions"><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@Model.DoctorId">Book with @Model.DoctorName.Split(' ').LastOrDefault()</a><span class="small-note">Includes a fixed &#8377;100 service fee</span></div></section>