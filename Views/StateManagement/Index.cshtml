@model StateManagementViewModel
@{ ViewData["Title"] = "State management"; }

<div class="page-heading"><div><p class="eyebrow">MVC PRACTICAL</p><h1>State management lab</h1><p>Test the four common techniques used in this demonstration without exposing sensitive information.</p></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="form-panel"><form asp-action="Save" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><h2>Set demonstration values</h2><p class="muted mb-4">These values are intentionally limited to a name and a specialization.</p><label asp-for="PatientName" class="form-label"></label><input asp-for="PatientName" class="form-control mb-3" placeholder="Patient name for cookie" /><label asp-for="Specialization" class="form-label"></label><select asp-for="Specialization" class="form-select mb-3"><option value="">Choose specialization for session</option><option>Cardiology</option><option>Dermatology</option><option>Pediatrics</option><option>Orthopedics</option><option>Neurology</option></select><button class="btn btn-primary" type="submit">Save demo values</button></form><form asp-action="ClearCookie" method="post" class="mt-3"><button class="btn btn-link p-0 text-link" type="submit">Clear patient cookie</button></form></div></div><div class="col-lg-5"><div class="state-card"><div class="state-item"><span class="state-label">Cookie</span><strong>@(Model.SavedPatientName ?? "Not set")</strong><p>Short-lived browser value, readable only as the demo patient name.</p></div><div class="state-item"><span class="state-label">Session</span><strong>@(Model.SavedSpecialization ?? "Not set")</strong><p>Server-side specialization identified by a session cookie.</p></div><div class="state-item"><span class="state-label">Query string</span><strong>/Doctors/Details?id=1</strong><p><a href="/Doctors/Details?id=1" class="text-link">Open doctor ID 1 details</a></p></div><div class="state-item"><span class="state-label">Hidden field</span><strong>DoctorId</strong><p>The appointment form carries the selected ID, then the server validates it again.</p></div></div></div></div>