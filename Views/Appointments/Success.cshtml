@model AppointmentConfirmationViewModel
@{ ViewData["Title"] = "Appointment confirmation"; }

<section class="success-panel"><div class="success-icon">&#10003;</div><p class="eyebrow">REQUEST RECEIVED</p><h1>Appointment request reviewed.</h1><p class="success-lead">Thanks, @Model.PatientName. Here is the summary of your in-memory demonstration request.</p><div class="confirmation-card"><div><span>Doctor</span><strong>@Model.DoctorName</strong></div><div><span>Date</span><strong>@Model.AppointmentDate.ToString("dddd, dd MMMM yyyy")</strong></div><div><span>Consultation</span><strong>&#8377;@Model.ConsultationFee.ToString("N0")</strong></div><div><span>Service fee</span><strong>&#8377;@Model.ServiceFee.ToString("N0")</strong></div><div class="highlight"><span>Total charge</span><strong>&#8377;@Model.TotalCharge.ToString("N0")</strong></div></div><p class="small-note">This is an educational demo. The appointment is not permanently saved and no real medical record was created.</p><div class="d-flex flex-wrap justify-content-center gap-2"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return to dashboard</a><a class="btn btn-light" asp-controller="Appointments" asp-action="Create">Book another</a></div></section>